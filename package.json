{
  "name": "zeppplayer",
  "version": "1.7.2",
  "description": "Unofficial ZeppOS emulator",
  "main": "src/runtime.js",
  "scripts": {
    "browser:build": "esbuild --bundle --outdir=app src/index.browser.js",
    "cli:build": "esbuild --bundle --platform=node --external:canvas --outdir=app src/index.cli.js",
    "browser:watch": "esbuild --bundle --outdir=app src/index.browser.js --watch",
    "build": "npm run browser:build && npm run cli:build",
    "server": "node src/server.js",
    "start": "node src/server.js",
    "mcp": "node bin/mcp.js",
    "test:unit": "node --test test/runtime-engine.test.js test/server-bridge.test.js test/playwright.test.mjs",
    "test:mcp": "node test/mcp.test.mjs",
    "test:playwright": "node --test test/playwright.test.mjs",
    "test:suites": "node bin/zepp-playwright.js",
    "test": "node --test test/runtime-engine.test.js test/server-bridge.test.js test/playwright.test.mjs && node test/mcp.test.mjs && node bin/zepp-playwright.js",
    "test:coverage": "node --test --experimental-test-coverage test/runtime-engine.test.js test/server-bridge.test.js test/playwright.test.mjs && node test/mcp.test.mjs && node bin/zepp-playwright.js"
  },
  "bin": {
    "zepp-preview": "app/index.cli.js",
    "zeppos-mcp": "bin/mcp.js",
    "zepp-playwright": "bin/zepp-playwright.js"
  },
  "repository": {
    "type": "git",
    "url": "https://notabug.org/melianmiko/ZeppPlayer"
  },
  "author": "MelianMiko",
  "license": "Apache 2.0",
  "dependencies": {
    "@types/node": "^20.10.5",
    "buffer": "^6.0.3",
    "express": "^5.3.0",
    "file-saver": "^2.0.5",
    "fs": "^0.0.1-security",
    "mini-signals": "^2.0.0",
    "socket.io": "^4.8.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.7",
    "esbuild": "^0.19.10",
    "gif-encoder-2": "^1.0.5",
    "normalize-path": "^3.0.0",
    "path-normalize": "^6.0.12",
    "preact": "^10.19.3",
    "tga": "^1.0.7",
    "uuid": "^9.0.1",
    "yargs": "^17.7.2"
  },
  "allowScripts": {
    "canvas@2.11.2": true
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "canvas": "^2.11.2"
  }
}
